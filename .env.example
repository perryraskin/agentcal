# Composio project credentials and connected-account IDs. Never commit real values.
COMPOSIO_API_KEY=
GOOGLE_CONNECTED_ACCOUNT_ID=
OUTLOOK_CONNECTED_ACCOUNT_ID=

# Calendar targets.
GOOGLE_CALENDAR_ID=primary
OUTLOOK_CALENDAR_ID=primary
SYNC_TIMEZONE=America/New_York

# Polling and bounded synchronization window.
SYNC_INTERVAL_SECONDS=120
SYNC_PAST_DAYS=30
SYNC_FUTURE_DAYS=365

# Service endpoint.
AGENTCAL_BIND_IP=127.0.0.1
AGENTCAL_PORT=8160
