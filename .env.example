# Composio "For You" connected-account IDs. Authentication state is mounted
# separately at /home/node/.composio; never commit that directory.
GOOGLE_CONNECTED_ACCOUNT=
OUTLOOK_CONNECTED_ACCOUNT=
EXPECTED_GOOGLE_EMAIL=perry.raskin@coverdash.com
EXPECTED_OUTLOOK_EMAIL=perry.raskin@coverdash.com
PROVIDER_TIMEOUT_MS=120000

# Calendar targets.
GOOGLE_CALENDAR_ID=primary
OUTLOOK_CALENDAR_ID=primary
SYNC_TIMEZONE=America/New_York

# Polling and bounded synchronization window.
SYNC_INTERVAL_SECONDS=120
SYNC_PAST_DAYS=30
SYNC_FUTURE_DAYS=365

# Service endpoint.
AGENTCAL_BIND_IP=127.0.0.1
AGENTCAL_PORT=8160
